# ── headless-duckapi (OpenAI-compatible API) configuration ───────────────────
# Copy this file to .env and fill in your values:  cp .env.example .env
# Every variable is optional; plain environment variables always win over .env.

# Optional — HTTP port (default 8080). On Faable this is set for you ($PORT).
#PORT=8080

# Optional — bearer token for the API. When set, clients must send
# "Authorization: Bearer <API_KEY>". Leave empty for an open server —
# fine for localhost, NOT recommended on a public host.
#API_KEY=

# Optional — "1" disables model aliasing: only exact model ids from the live
# duck.ai list resolve (anything else -> 404), and a model duck.ai rejects
# (restricted/unavailable) errors out instead of silently switching to
# another model of the same family. Recommended for deployments.
#STRICT_MODELS=1
